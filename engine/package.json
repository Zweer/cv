{
  "name": "cv-tailoring-engine",
  "version": "1.0.0",
  "private": true,
  "description": "On-demand CV tailoring engine: posting guard, base+delta merge, and the LinkedIn search portal. Node + TypeScript, run directly with Node's native type stripping (no build step).",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\" \"portals/linkedin-search/cli/tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "he": "2.0.0",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/he": "1.2.3",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
